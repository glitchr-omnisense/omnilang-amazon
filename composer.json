{
    "name": "omnilang/amazon",
    "type": "library",
    "description": "Omnilang's Amazon Translate, under any PHP host and without the AWS SDK: texts translated with formality, the source language detected by \"auto\", custom terminologies as glossaries, HTML, text and DOCX documents translated at once - every call signed with Signature Version 4, the credentials given by reference, Amazon's limits and data use declared as data.",
    "keywords": [
        "amazon",
        "amazon-translate",
        "aws",
        "sigv4",
        "translation",
        "machine-translation",
        "glossary",
        "document-translation",
        "framework-agnostic",
        "omnilang"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnilang-amazon",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0",
        "omnisense/omnilang": "^1.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnilang\\Amazon\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnilang\\Amazon\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
